import queue
import json
import subprocess
import requests
import sounddevice as sd
from vosk import Model, KaldiRecognizer

MODEL_PATH = "vosk-model-small-en-us-0.15"
MIC_DEVICE = 11
SAMPLE_RATE = 16000
OLLAMA_MODEL = "qwen2:0.5b"
HDMI_DEVICE = "plughw:0,3"

audio_queue = queue.Queue()
speaking = False

def audio_callback(indata, frames, time, status):
global speaking
if speaking:
return
if status:
print(status)
audio_queue.put(bytes(indata))

def load_speech_model():
print("Loading speech model...")
return Model(MODEL_PATH)

def create_recognizer(model):
grammar = (
'["what","why","how","plus","minus","times",'
'"equal","equals","two","three","four","five",'
'"six","seven","eight","nine","ten"]'
)
return KaldiRecognizer(model, SAMPLE_RATE, grammar)

def ask_llm(text):
url = "http://localhost:11434/api/generate
"
prompt = (
"You are a helpful AI voice assistant.\n"
"Answer clearly and briefly.\n\n"
"User: " + text + "\n"
"Assistant:"
)
payload = {
"model": OLLAMA_MODEL,
"prompt": prompt,
"stream": False
}
try:
response = requests.post(url, json=payload)
return response.json()["response"].strip()
except Exception as e:
print("LLM Error:", e)
return "I cannot connect to the language model."

def speak(text):
global speaking
speaking = True
clean_text = text.replace('"', '')
command = (
'espeak-ng --stdout "{}" | '
'aplay -D {} -f S16_LE -r 48000 -c 2'
).format(clean_text, HDMI_DEVICE)
subprocess.run(command, shell=True)
speaking = False

def main():
model = load_speech_model()
recognizer = create_recognizer(model)
print("Assistant is listening...")
with sd.RawInputStream(device=MIC_DEVICE,
samplerate=SAMPLE_RATE,
blocksize=8000,
dtype='int16',
channels=1,
callback=audio_callback):
while True:
data = audio_queue.get()
if recognizer.AcceptWaveform(data):
result = json.loads(recognizer.Result())
text = result.get("text", "").strip()
if text and len(text.split()) >= 2:
print("You said:", text)
reply = ask_llm(text)
print("Assistant:", reply)
speak(reply)

if name == "main":
main()

